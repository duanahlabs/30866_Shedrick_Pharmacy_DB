CREATE OR REPLACE PACKAGE pharmacy_pkg IS
    PROCEDURE register_prescription(
        p_prescription_id NUMBER,
        p_patient_id      NUMBER,
        p_doctor_id       NUMBER
    );
    PROCEDURE dispense_drug(
        p_prescription_item_id NUMBER,
        p_batch_id              NUMBER,
        p_employee_id            NUMBER,
        p_quantity               NUMBER
    );
    FUNCTION check_stock(
        p_batch_id NUMBER
    ) RETURN NUMBER;
END pharmacy_pkg;
/

CREATE OR REPLACE PACKAGE BODY pharmacy_pkg IS

    PROCEDURE register_prescription(
        p_prescription_id NUMBER,
        p_patient_id      NUMBER,
        p_doctor_id       NUMBER
    ) IS
    BEGIN
        INSERT INTO prescriptions
        VALUES (p_prescription_id, p_patient_id, p_doctor_id, SYSDATE, 'Pending');
    END;

    PROCEDURE dispense_drug(
        p_prescription_item_id NUMBER,
        p_batch_id              NUMBER,
        p_employee_id            NUMBER,
        p_quantity               NUMBER
    ) IS
        v_dispensing_id NUMBER;
    BEGIN
        UPDATE stock_batches
        SET quantity_available = quantity_available - p_quantity
        WHERE batch_id = p_batch_id
          AND quantity_available >= p_quantity;

        IF SQL%ROWCOUNT = 0 THEN
            RAISE_APPLICATION_ERROR(-20030, 'Insufficient stock in this batch.');
        END IF;

        SELECT NVL(MAX(dispensing_id), 0) + 1
        INTO v_dispensing_id
        FROM dispensing;

        INSERT INTO dispensing (
            dispensing_id, prescription_item_id, batch_id,
            employee_id, quantity_dispensed, dispensing_date
        ) VALUES (
            v_dispensing_id, p_prescription_item_id, p_batch_id,
            p_employee_id, p_quantity, SYSDATE
        );
    END;

    FUNCTION check_stock(
        p_batch_id NUMBER
    ) RETURN NUMBER IS
        v_qty NUMBER;
    BEGIN
        SELECT quantity_available
        INTO v_qty
        FROM stock_batches
        WHERE batch_id = p_batch_id;

        RETURN v_qty;
    END;

END pharmacy_pkg;
/
