CREATE OR REPLACE PROCEDURE safe_stock_check(

p_batch_id NUMBER

)

IS

v_quantity NUMBER;

BEGIN

SELECT quantity

INTO v_quantity

FROM stock_batches

WHERE batch_id = p_batch_id;

DBMS_OUTPUT.PUT_LINE(

'Quantity: '

|| v_quantity

);

EXCEPTION

WHEN NO_DATA_FOUND THEN

DBMS_OUTPUT.PUT_LINE(

'Batch does not exist.'

);

WHEN OTHERS THEN

DBMS_OUTPUT.PUT_LINE(

SQLERRM

);

END;
/
