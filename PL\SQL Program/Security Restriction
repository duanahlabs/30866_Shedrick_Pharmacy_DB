 ROLES — one per actor type from the Business Process design
-- ------------------------------------------------------------
CREATE ROLE pharmacist_role;
CREATE ROLE cashier_role;
CREATE ROLE inventory_manager_role;
CREATE ROLE doctor_role;
CREATE ROLE auditor_role;
 
-- ------------------------------------------------------------
-- 2. OBJECT PRIVILEGES — grant only what each role's job needs
-- ------------------------------------------------------------
 
-- PHARMACIST: verifies prescriptions, dispenses drugs, reads stock
GRANT SELECT ON 30866_Shedrick_Pharmacy_DB.prescriptions TO pharmacist_role;
GRANT SELECT, UPDATE ON 30866_Shedrick_Pharmacy_DB.prescriptions TO pharmacist_role;
GRANT SELECT ON 30866_Shedrick_Pharmacy_DB.prescription_items TO pharmacist_role;
GRANT SELECT ON 30866_Shedrick_Pharmacy_DB.stock_batches TO pharmacist_role;
GRANT SELECT, INSERT ON 30866_Shedrick_Pharmacy_DB.dispensing TO pharmacist_role;
GRANT EXECUTE ON 30866_Shedrick_Pharmacy_DB.dispense_drug TO pharmacist_role;
GRANT EXECUTE ON 30866_Shedrick_Pharmacy_DB.check_stock TO pharmacist_role;
GRANT EXECUTE ON 30866_Shedrick_Pharmacy_DB.expiry_status TO pharmacist_role;
 
-- CASHIER: reads prescriptions/dispensing, records payment
GRANT SELECT ON 30866_Shedrick_Pharmacy_DB.prescriptions TO cashier_role;
GRANT SELECT ON 30866_Shedrick_Pharmacy_DB.dispensing TO cashier_role;
GRANT SELECT, INSERT ON 30866_Shedrick_Pharmacy_DB.sales TO cashier_role;
 
-- INVENTORY MANAGER: manages stock and suppliers, restocks drugs
GRANT SELECT, INSERT, UPDATE ON 30866_Shedrick_Pharmacy_DB.stock_batches TO inventory_manager_role;
GRANT SELECT, INSERT, UPDATE ON 30866_Shedrick_Pharmacy_DB.suppliers TO inventory_manager_role;
GRANT SELECT ON 30866_Shedrick_Pharmacy_DB.drugs TO inventory_manager_role;
GRANT EXECUTE ON 30866_Shedrick_Pharmacy_DB.restock_drug TO inventory_manager_role;
GRANT EXECUTE ON 30866_Shedrick_Pharmacy_DB.check_stock TO inventory_manager_role;
GRANT EXECUTE ON 30866_Shedrick_Pharmacy_DB.expiry_status TO inventory_manager_role;
 
-- DOCTOR: issues prescriptions only — no stock/financial access
GRANT SELECT, INSERT ON 30866_Shedrick_Pharmacy_DB.prescriptions TO doctor_role;
GRANT SELECT, INSERT ON 30866_Shedrick_Pharmacy_DB.prescription_items TO doctor_role;
GRANT EXECUTE ON 30866_Shedrick_Pharmacy_DB.register_prescription TO doctor_role;
 
-- AUDITOR: read-only access to the audit trail and activity log —
-- no access to operational tables at all, since an auditor's job
-- is oversight, not data entry
GRANT SELECT ON 30866_Shedrick_Pharmacy_DB.audit_log TO auditor_role;
GRANT SELECT ON 30866_Shedrick_Pharmacy_DB.user_activity TO auditor_role;
 
-- ------------------------------------------------------------
-- 3. USERS — one demo account per role, so you can log in as
--    each actor and prove the privilege boundaries during your
--    live demonstration (Section 8 of the requirements)
-- ------------------------------------------------------------
CREATE USER pharmacist_demo IDENTIFIED BY "Pharm_2026#";
CREATE USER cashier_demo    IDENTIFIED BY "Cash_2026#";
CREATE USER inventory_demo  IDENTIFIED BY "Inv_2026#";
CREATE USER doctor_demo     IDENTIFIED BY "Doc_2026#";
CREATE USER auditor_demo    IDENTIFIED BY "Audit_2026#";
 
-- every demo user needs to be able to log in and reach the schema
GRANT CREATE SESSION TO pharmacist_demo, cashier_demo, inventory_demo, doctor_demo, auditor_demo;
 
GRANT pharmacist_role      TO pharmacist_demo;
GRANT cashier_role         TO cashier_demo;
GRANT inventory_manager_role TO inventory_demo;
GRANT doctor_role          TO doctor_demo;
GRANT auditor_role         TO auditor_demo;
 
-- so each demo user can reference tables without schema-prefixing
-- every query (e.g. SELECT * FROM prescriptions instead of
-- SELECT * FROM "30866_Shedrick_Pharmacy_DB".prescriptions)
CREATE SYNONYM pharmacist_demo.prescriptions      FOR 30866_Shedrick_Pharmacy_DB.prescriptions;
CREATE SYNONYM pharmacist_demo.prescription_items FOR 30866_Shedrick_Pharmacy_DB.prescription_items;
CREATE SYNONYM pharmacist_demo.stock_batches      FOR 30866_Shedrick_Pharmacy_DB.stock_batches;
CREATE SYNONYM pharmacist_demo.dispensing         FOR 30866_Shedrick_Pharmacy_DB.dispensing;
 
CREATE SYNONYM cashier_demo.prescriptions FOR 30866_Shedrick_Pharmacy_DB.prescriptions;
CREATE SYNONYM cashier_demo.dispensing    FOR 30866_Shedrick_Pharmacy_DB.dispensing;
CREATE SYNONYM cashier_demo.sales         FOR 30866_Shedrick_Pharmacy_DB.sales;
 
CREATE SYNONYM inventory_demo.stock_batches FOR 30866_Shedrick_Pharmacy_DB.stock_batches;
CREATE SYNONYM inventory_demo.suppliers     FOR 30866_Shedrick_Pharmacy_DB.suppliers;
CREATE SYNONYM inventory_demo.drugs         FOR 30866_Shedrick_Pharmacy_DB.drugs;
 
CREATE SYNONYM doctor_demo.prescriptions      FOR 30866_Shedrick_Pharmacy_DB.prescriptions;
CREATE SYNONYM doctor_demo.prescription_items FOR 30866_Shedrick_Pharmacy_DB.prescription_items;
 
CREATE SYNONYM auditor_demo.audit_log     FOR 30866_Shedrick_Pharmacy_DB.audit_log;
CREATE SYNONYM auditor_demo.user_activity FOR 30866_Shedrick_Pharmacy_DB.user_activity;
 
-- ------------------------------------------------------------
-- 4. PASSWORD POLICY — a small, easy-to-explain security touch
--    (shows deliberate security thinking beyond just grants)
-- ------------------------------------------------------------
CREATE PROFILE pharmacy_staff_profile LIMIT
    FAILED_LOGIN_ATTEMPTS   3
    PASSWORD_LOCK_TIME      1
    PASSWORD_LIFE_TIME      90
    PASSWORD_REUSE_TIME     365;
 
ALTER USER pharmacist_demo PROFILE pharmacy_staff_profile;
ALTER USER cashier_demo    PROFILE pharmacy_staff_profile;
ALTER USER inventory_demo  PROFILE pharmacy_staff_profile;
ALTER USER doctor_demo     PROFILE pharmacy_staff_profile;
ALTER USER auditor_demo    PROFILE pharmacy_staff_profile;
 
